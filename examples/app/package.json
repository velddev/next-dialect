{
  "name": "example-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next-dialect build",
    "serve": "node scripts/serve.mjs",
    "build:ssr": "cross-env DIALECT_SSR=1 next-dialect build",
    "start:ssr": "cross-env DIALECT_SSR=1 next-dialect start",
    "test": "npm run build && npm run build:ssr && node tests/run.mjs && node tests/proxy.mjs && playwright test",
    "test:http": "node tests/run.mjs",
    "test:proxy": "node tests/proxy.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@babel/runtime": "7.29.7",
    "next": "15.1.6",
    "next-dialect": "*",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "cross-env": "^10.1.0"
  }
}
